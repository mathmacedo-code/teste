# URL pública do site (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://vilamedi.com.br

# Rastreamento (opcional) — carregados só se preenchidos
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Integração de leads (reservas e eventos).
# O endpoint /api/leads repassa cada lead em JSON para este webhook
# (RD Station, HubSpot, Kommo, Make, Zapier, n8n...).
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
